---
import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";
---

<section
	id="hero"
	class="mx-auto max-w-6xl px-6 pt-10 pb-12 sm:pt-16 md:pt-20 md:pb-16"
>
	<div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-start md:gap-12">
		<Image
			src={profile}
			alt="Portrait von Paul Scholl"
			width={192}
			height={192}
			densities={[1, 1.5]}
			loading="eager"
			fetchpriority="high"
			class="shadow-hard h-36 w-36 border-2 border-fg object-cover md:order-last md:mt-2 md:h-48 md:w-48"
		/>
		<div>
			<h1
				class="font-display text-[clamp(3.5rem,17vw,10rem)] leading-[0.85] font-black tracking-tighter uppercase"
			>
				<span class="block">Paul</span>
				<span class="block">Scholl</span>
			</h1>
			<p class="eyebrow mt-6 sm:text-base">Webentwickler & AI Engineer</p>
			<p class="mt-3 max-w-xl text-lg text-muted">
				Webentwickler aus dem Saarland. PHP, WooCommerce und
				datenbankgestützte Webanwendungen.
			</p>
		</div>
	</div>

	<p
		class="mt-8 inline-flex items-center gap-2.5 border border-line px-3 py-1.5 text-sm font-medium"
	>
		<span class="h-2 w-2 bg-accent" aria-hidden="true"></span>
		Verfügbar ab Oktober 2026
	</p>
	<div class="mt-6 flex flex-wrap gap-3">
		<a href="#kontakt" class="btn btn-primary">Kontakt aufnehmen</a>
		<a href="#projekte" class="btn btn-outline">Projekte ansehen</a>
		<a
			href="https://github.com/pauli0202/paulscholl"
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-outline"
		>
			Quellcode auf GitHub
			<svg
				class="icon"
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
			>
				<path d="M7 17 17 7M8 7h9v9"></path>
			</svg>
			<span class="sr-only">(öffnet in neuem Tab)</span>
		</a>
	</div>
</section>
