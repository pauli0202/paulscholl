---
const channels = [
	{
		label: "E-Mail",
		value: "paul.scholl21.11@icloud.com",
		href: "mailto:paul.scholl21.11@icloud.com",
		external: false,
	},
	{
		label: "Telefon",
		value: "+49 171 7049689",
		href: "tel:+491717049689",
		external: false,
	},
	{
		label: "LinkedIn",
		value: "paul-scholl",
		href: "https://www.linkedin.com/in/paul-scholl-3161b01a3/",
		external: true,
	},
];
---

<section id="kontakt" class="section">
	<h2 class="section-title">Kontakt</h2>
	<div class="mt-10 grid gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
		<p class="max-w-xl text-lg text-muted">
			Du hast Interesse an einer Zusammenarbeit? Ich freue mich über deine
			Nachricht – per E-Mail, Telefon oder LinkedIn.
		</p>
		<ul class="border-t-2 border-fg">
			{
				channels.map((channel) => (
					<li class="border-b-2 border-fg">
						<a
							href={channel.href}
							target={channel.external ? "_blank" : undefined}
							rel={channel.external ? "noopener noreferrer" : undefined}
							class="group flex min-h-16 items-center justify-between gap-4 px-3 py-4 transition-colors duration-150 hover:bg-fg hover:text-bg"
						>
							<span class="min-w-0">
								<span class="label block group-hover:text-bg">
									{channel.label}
								</span>
								<span class="mt-1 block font-display text-lg leading-snug font-bold break-words sm:text-2xl">
									{channel.value}
								</span>
							</span>
							<svg
								class="h-6 w-6 shrink-0"
								aria-hidden="true"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="square"
							>
								<path d="M7 17 17 7M8 7h9v9" />
							</svg>
							{channel.external && (
								<span class="sr-only">(öffnet in neuem Tab)</span>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
