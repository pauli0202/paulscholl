---
const categories = [
	{
		title: "Backend & Datenbanken",
		skills: [
			"PHP",
			"MySQL",
			"REST-APIs & Schnittstellen",
			"Daten-Import & -Export",
			"Custom WordPress-Plugins",
			"Produktfilter & Suchindizes",
			"Preis- & Exportmodule",
			"Druckfunktionen",
		],
	},
	{
		title: "E-Commerce",
		skills: [
			"WooCommerce (B2B/B2C)",
			"Staffelpreise",
			"Reverse-Charge",
			"Produktdaten & Bestellprozesse",
			"Shop-Konfiguratoren",
			"Mehrsprachige Shops",
		],
	},
	{
		title: "Frontend",
		skills: [
			"Astro",
			"Tailwind CSS",
			"TypeScript",
			"JavaScript",
			"HTML",
			"CSS",
			"Figma-Umsetzung",
			"Responsive Interfaces",
			"Performance-Optimierung",
		],
	},
	{
		title: "WordPress & CMS",
		skills: [
			"WordPress",
			"Custom Plugin-Entwicklung",
			"Oxygen",
			"Divi",
			"Elementor",
			"ACF",
			"Polylang",
			"DSGVO & Consent-Management",
		],
	},
	{
		title: "KI & Agentic Engineering",
		skills: [
			"Claude Code",
			"Agentic Workflows",
			"LLM-Integration",
			"Harness Engineering (Push, Pointer Memory)",
		],
	},
	{
		title: "Infrastruktur & IT-Administration",
		skills: [
			"Microsoft 365 Administration",
			"E-Mail-Sicherheit (SPF, DKIM, DMARC)",
			"DNS",
			"Git",
			"DevOps",
		],
	},
];
---

<section id="skills" class="section">
	<h2 class="section-title">Skills & Tech-Stack</h2>
	<!-- gap-px over a line-coloured background draws the visible grid lines -->
	<div
		class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
	>
		{
			categories.map((category) => (
				<div class="flex flex-col bg-bg p-6">
					<div class="flex items-baseline justify-between gap-4">
						<h3 class="font-display text-lg leading-snug font-bold">
							{category.title}
						</h3>
						<span class="label tabular-nums" aria-hidden="true">
							{String(category.skills.length).padStart(2, "0")}
						</span>
					</div>
					<ul class="mt-4 flex flex-wrap gap-2">
						{category.skills.map((skill) => (
							<li class="tag">{skill}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>
