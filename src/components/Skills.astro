---
const categories = [
	{
		title: "Backend & Datenbanken",
		skills: [
			"PHP",
			"MySQL",
			"REST-APIs & Schnittstellen",
			"Daten-Import & -Export",
			"Custom WordPress-Plugins",
			"Produktfilter & Suchindizes",
			"Preis- & Exportmodule",
			"Druckfunktionen",
		],
	},
	{
		title: "E-Commerce",
		skills: [
			"WooCommerce (B2B/B2C)",
			"Staffelpreise",
			"Reverse-Charge",
			"Produktdaten & Bestellprozesse",
			"Shop-Konfiguratoren",
			"Mehrsprachige Shops",
		],
	},
	{
		title: "Frontend",
		skills: [
			"Astro",
			"Tailwind CSS",
			"TypeScript",
			"JavaScript",
			"HTML",
			"CSS",
			"Figma-Umsetzung",
			"Responsive Interfaces",
			"Performance-Optimierung",
		],
	},
	{
		title: "WordPress & CMS",
		skills: [
			"WordPress",
			"Custom Plugin-Entwicklung",
			"Oxygen",
			"Divi",
			"Elementor",
			"ACF",
			"Polylang",
			"DSGVO & Consent-Management",
		],
	},
	{
		title: "KI & Agentic Engineering",
		skills: [
			"Claude Code",
			"Agentic Workflows",
			"LLM-Integration",
			"Harness Engineering (Push, Pointer Memory)",
		],
	},
	{
		title: "Infrastruktur & IT-Administration",
		skills: [
			"Microsoft 365 Administration",
			"E-Mail-Sicherheit (SPF, DKIM, DMARC)",
			"DNS",
			"Git",
			"DevOps",
		],
	},
];
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-16 md:py-24">
	<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
		Skills & Tech-Stack
	</h2>
	<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			categories.map((category) => (
				<div class="flex flex-col rounded-lg border border-slate-200 p-6 dark:border-slate-800">
					<h3 class="font-semibold text-slate-900 dark:text-slate-100">
						{category.title}
					</h3>
					<div class="mt-4 flex flex-wrap gap-2">
						{category.skills.map((skill) => (
							<span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300">
								{skill}
							</span>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
