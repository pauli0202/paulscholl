---
import { Image } from "astro:assets";
import pocketrocket from "../assets/projects/pocketrocket.jpg";
import schroeder from "../assets/projects/schroeder-fleischwaren.webp";
import flughafen from "../assets/projects/flughafen-saarbruecken.webp";

const projects = [
	{
		title: "Pocket Rocket",
		description: "Digitalagentur Saarland",
		role: "Custom Plugin & Frontend-Entwicklung",
		href: "https://pocketrocket.de/",
		image: pocketrocket,
	},
	{
		title: "Schröder Wurstmanufaktur",
		description: "Traditionelle Fleischerei",
		role: "WordPress-Entwicklung & Custom Plugins",
		href: "https://schroeder-fleischwaren.de/",
		image: schroeder,
	},
	{
		title: "Flughafen Saarbrücken",
		description: "Offizielle Flughafen-Website",
		role: "WordPress-Umsetzung & Wartung",
		href: "https://www.flughafen-saarbruecken.de/",
		image: flughafen,
	},
];
---

<section id="projekte" class="mx-auto max-w-5xl px-6 py-16 md:py-24">
	<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Projekte</h2>
	<div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
		{
			projects.map((project) => (
				<a
					href={project.href}
					target="_blank"
					rel="noopener noreferrer"
					class="group block overflow-hidden rounded-lg border border-slate-200 transition-colors hover:border-indigo-500 dark:border-slate-800 dark:hover:border-indigo-400"
				>
					<Image
						src={project.image}
						alt={project.title}
						width={640}
						height={400}
						class="h-40 w-full object-cover"
					/>
					<div class="p-5">
						<h3 class="font-semibold text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400">
							{project.title}
						</h3>
						<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
							{project.description}
						</p>
						<p class="mt-3 text-sm font-medium text-indigo-600 dark:text-indigo-400">
							{project.role}
						</p>
					</div>
				</a>
			))
		}
	</div>
</section>
