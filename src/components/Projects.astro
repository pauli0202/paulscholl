---
import { Image } from "astro:assets";
import pocketrocket from "../assets/projects/pocketrocket.jpg";
import schroeder from "../assets/projects/schroeder-fleischwaren.webp";
import flughafen from "../assets/projects/flughafen-saarbruecken.webp";

const projects = [
	{
		title: "Pocket Rocket",
		description: "Digitalagentur Saarland",
		role: "Custom Plugin & Frontend-Entwicklung",
		href: "https://pocketrocket.de/",
		image: pocketrocket,
	},
	{
		title: "Schröder Wurstmanufaktur",
		description: "Traditionelle Fleischerei",
		role: "WordPress-Entwicklung & Custom Plugins",
		href: "https://schroeder-fleischwaren.de/",
		image: schroeder,
	},
	{
		title: "Flughafen Saarbrücken",
		description: "Offizielle Flughafen-Website",
		role: "WordPress-Umsetzung & Wartung",
		href: "https://www.flughafen-saarbruecken.de/",
		image: flughafen,
	},
];
---

<section id="projekte" class="section">
	<h2 class="section-title">Projekte</h2>
	<ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
		{
			projects.map((project) => (
				<li class="flex">
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex w-full flex-col border-2 border-fg bg-card transition-[translate,box-shadow] duration-150 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[6px_6px_0_0_var(--accent)] focus-visible:-translate-x-1 focus-visible:-translate-y-1 focus-visible:shadow-[6px_6px_0_0_var(--accent)]"
					>
						<Image
							src={project.image}
							alt=""
							width={640}
							height={400}
							class="aspect-[16/10] w-full border-b-2 border-fg object-cover"
						/>
						<div class="flex flex-1 flex-col p-5">
							<h3 class="font-display text-xl leading-snug font-bold">
								{project.title}
							</h3>
							<p class="mt-1 text-sm text-muted">{project.description}</p>
							<p class="mt-3 text-sm font-medium text-accent">
								{project.role}
							</p>
							<p class="label mt-auto flex items-center justify-between gap-3 border-t border-line pt-4 text-fg">
								<span class="truncate tracking-normal normal-case">
									{new URL(project.href).hostname.replace(/^www\./, "")}
								</span>
								<svg
									class="icon transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="square"
								>
									<path d="M7 17 17 7M8 7h9v9" />
								</svg>
								<span class="sr-only">(öffnet in neuem Tab)</span>
							</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</section>
