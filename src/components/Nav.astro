---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	{ href: "#ueber-mich", label: "Über mich" },
	{ href: "#skills", label: "Skills" },
	{ href: "#projekte", label: "Projekte" },
	{ href: "#erfahrung", label: "Lebenslauf" },
	{ href: "#kontakt", label: "Kontakt" },
];
---

<header
	id="site-header"
	class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md"
>
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-2">
		<a
			href="#hero"
			class="flex min-h-11 items-center font-display text-base font-extrabold tracking-tight uppercase"
		>
			Paul Scholl
		</a>
		<nav aria-label="Hauptnavigation" class="hidden items-center gap-1 md:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						data-nav-link
						data-target={link.href.slice(1)}
						class="flex min-h-11 items-center border-b-2 border-transparent px-3 text-sm font-medium tracking-wide text-muted uppercase transition-colors duration-150 hover:text-fg data-active:border-accent data-active:text-fg"
					>
						{link.label}
					</a>
				))
			}
		</nav>
		<ThemeToggle />
	</div>
	<!-- Fading right edge signals that the strip scrolls horizontally -->
	<nav
		aria-label="Hauptnavigation"
		data-nav-strip
		class="flex gap-1 overflow-x-auto border-t border-line px-3 whitespace-nowrap [mask-image:linear-gradient(to_right,#000_calc(100%-2.5rem),transparent)] [scrollbar-width:none] md:hidden [&::-webkit-scrollbar]:hidden"
	>
		{
			links.map((link) => (
				<a
					href={link.href}
					data-nav-link
					data-target={link.href.slice(1)}
					class="flex min-h-11 shrink-0 items-center border-b-2 border-transparent px-3 text-sm last:mr-8 font-medium tracking-wide text-muted uppercase transition-colors duration-150 hover:text-fg data-active:border-accent data-active:text-fg"
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<script is:inline>
	(function () {
		const header = document.getElementById("site-header");
		if (!header) return;

		const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));
		const sections = navLinks
			.map((link) => document.getElementById(link.dataset.target || ""))
			.filter(Boolean);

		const strip = header.querySelector("[data-nav-strip]");

		function setActive(id) {
			navLinks.forEach((link) => {
				const isActive = link.dataset.target === id;
				link.toggleAttribute("data-active", isActive);
				if (isActive) link.setAttribute("aria-current", "location");
				else link.removeAttribute("aria-current");
				// Keep the active link visible inside the mobile scroll strip
				if (isActive && strip && strip.contains(link)) {
					strip.scrollTo({
						left: link.offsetLeft - strip.clientWidth / 2 + link.offsetWidth / 2,
					});
				}
			});
		}

		if ("IntersectionObserver" in window && sections.length) {
			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (visible) setActive(visible.target.id);
				},
				{ rootMargin: "-40% 0px -50% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] },
			);
			sections.forEach((section) => observer.observe(section));
		}
	})();
</script>
