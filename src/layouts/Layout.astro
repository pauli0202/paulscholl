---
import "@fontsource-variable/archivo";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";

const title = "Paul Scholl — Webentwickler & AI Engineer";
const description =
	"Paul Scholl – Webentwickler & AI Engineer aus dem Saarland. PHP, WooCommerce und datenbankgestützte Webanwendungen, dazu KI-Tooling für schnellere Workflows.";
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			name="theme-color"
			content="#fafafa"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#09090b"
			media="(prefers-color-scheme: dark)"
		/>
		<title>{title}</title>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				if (stored === "dark" || (!stored && prefersDark)) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body class="bg-bg font-sans text-fg antialiased">
		<a href="#inhalt" class="skip-link">Zum Inhalt springen</a>
		<slot />
	</body>
</html>
